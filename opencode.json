{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "command": {
    "build": {
      "description": "Compilar todo el proyecto",
      "template": "Ejecuta: mvn clean install -DskipTests"
    },
    "test-server": {
      "description": "Tests del servidor",
      "template": "Ejecuta: mvn test -pl server -Dtest=\"!*IntegrationTest\""
    },
    "test-client": {
      "description": "Tests UI del cliente",
      "template": "Ejecuta: mvn test -pl client"
    },
    "run-server": {
      "description": "Iniciar servidor WebSocket en puerto 8080",
      "template": "Ejecuta: java -jar server/target/server-1.0-SNAPSHOT.jar"
    },
    "run-client": {
      "description": "Iniciar cliente JavaFX",
      "template": "Ejecuta: mvn javafx:run -pl client"
    }
  },
  "mcp": {
    "client-alpha": {
      "type": "local",
      "command": ["cmd", "/c", "tools\\launch_mcp_client.cmd", "--mcp", "--username", "alpha", "--password", "pass", "--auto-register", "--auto-create", "--x", "0", "--y", "0"],
      "enabled": false
    },
    "client-bravo": {
      "type": "local",
      "command": ["cmd", "/c", "tools\\launch_mcp_client.cmd", "--mcp", "--username", "bravo", "--password", "pass", "--auto-register", "--auto-join", "--x", "820", "--y", "0"],
      "enabled": false
    },
    "client-charlie": {
      "type": "local",
      "command": ["cmd", "/c", "tools\\launch_mcp_client.cmd", "--mcp", "--username", "charlie", "--password", "pass", "--auto-register", "--auto-join", "--x", "0", "--y", "500"],
      "enabled": false
    },
    "client-delta": {
      "type": "local",
      "command": ["cmd", "/c", "tools\\launch_mcp_client.cmd", "--mcp", "--username", "delta", "--password", "pass", "--auto-register", "--auto-join", "--x", "820", "--y", "500"],
      "enabled": false
    }
  }
}
