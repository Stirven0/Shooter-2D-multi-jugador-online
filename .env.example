# ============================================
# MULTIPLAYER SHOOTER — Configuración
# ============================================
# Este archivo documenta todas las system properties configurables.
# Se pasan como -Dkey=value al JVM (java -Dkey=value -jar ...).
# Los defaults de ServerConfig.java coinciden con estos valores.

# --- Base de datos ---
DB_URL=jdbc:sqlite:shooter.db
DB_USER=
DB_PASSWORD=

# --- Servidor WebSocket ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# --- JWT / Sesiones ---
JWT_SECRET=cambia_esto_en_produccion

# --- Game loop ---
TICK_RATE=20
# PLAYER_SPEED=200.0
# PLAYER_SPRINT_SPEED=300.0
# BULLET_SPEED=600.0
# FIRE_RATE_MS=250.0
# BULLET_DAMAGE=25.0
# BULLET_LIFETIME_MS=5000.0
# PLAYER_RADIUS=15.0
# BULLET_RADIUS=3.0

# --- Salas ---
MAX_PLAYERS_PER_ROOM=10
MIN_PLAYERS_TO_START=2

# --- Timeouts ---
# CONNECTION_TIMEOUT_MS=0
# TIMEOUT_CHECK_INTERVAL_MS=10000
IDLE_THRESHOLD_MS=30000
IDLE_WARNING_DURATION_MS=10000

# --- Cliente ---
SERVER_URL=ws://localhost:8080
